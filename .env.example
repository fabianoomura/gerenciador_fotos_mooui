# API FastAPI (servidor interno)
CATALOGO_HOST=127.0.0.1
CATALOGO_PORT=8010
CATALOGO_DB=/path/to/catalog.db
CATALOGO_CORS_ORIGINS=http://localhost:7777
CATALOGO_API_TOKEN=replace-with-a-long-random-token

# Proxy Next.js (somente no servidor; não usar prefixo NEXT_PUBLIC_)
API_INTERNAL_URL=http://127.0.0.1:8010
ALLOWED_DEV_ORIGINS=localhost
CATALOGO_PUBLIC_URL=http://localhost:7777
